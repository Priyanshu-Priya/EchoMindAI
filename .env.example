# ============================================================
# EchoMind AI — Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit your real .env file to version control.
# ============================================================


# ------------------------------------------------------------
# Supabase
# Your project URL and service role key from:
# https://supabase.com/dashboard → Project Settings → API
# Use the "service_role" key (not the anon key) so the bot
# can read and write to all tables without RLS restrictions.
# ------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-service-role-key


# ------------------------------------------------------------
# Telegram Bot
# Create a bot via @BotFather on Telegram and paste the token here.
# Format: <bot-id>:<token-string>
# ------------------------------------------------------------
TELEGRAM_BOT_TOKEN=your-telegram-bot-token


# ------------------------------------------------------------
# Groq API
# Get your free API key from: https://console.groq.com/keys
# The bot uses the openai/gpt-oss-120b model on Groq's LPU.
# ------------------------------------------------------------
GROQ_API_KEY=gsk_your-groq-api-key


# ------------------------------------------------------------
# Authorization
# Comma-separated list of Telegram usernames or numeric user IDs
# that are allowed to interact with the bot.
# Use @userinfobot on Telegram to find your numeric user ID.
# Example: AUTHORIZED_USER_IDS=@yourhandle,123456789
# ------------------------------------------------------------
AUTHORIZED_USER_IDS=@yourusername
